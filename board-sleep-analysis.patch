+const pick = (list: string[]): string =>
+  list[Math.floor(Math.random() * list.length)];
+
+const SLEEP_START = [
+  '잘 자요. 공부는 제가 대신 못 합니다.',
+  '도서관을 숙박시설로 이용해 주셔서 감사합니다.',
+  '오늘의 학습 성과: 렘수면 진입 성공.',
+];
+
+const PHONE = [
+  '혹시 게임하는 거 아니죠?',
+  '도서관 와이파이 쓰러 오셨군요.',
+  '현재 가장 활발하게 활동 중인 신체 부위는 엄지손가락입니다.',
+  '이 정도면 집에서 누워서 하시는 게 더 효율적입니다.',
+  '지금 그 화면, 내일 시험 범위가 아닙니다.',
+  '학점이 당신의 엄지를 지켜보고 있습니다.',
+];
+
+const SLACK = [
+  '학점은 브론즈인데 게임은 다이아시네요.',
+  '교수님이 주신 퀘스트부터 완료하시죠.',
+  '현재 게임 승률보다 과제 제출 확률이 낮아 보입니다.',
+];
+
+export const pickSleepStart = () => pick(SLEEP_START);
+export const pickPhoneMessage = () => pick(PHONE);
+export const pickSlackMessage = () => pick(SLACK);
diff --git a/frontend/src/features/ai-analysis/lib/prone.ts b/frontend/src/features/ai-analysis/lib/prone.ts
new file mode 100644
index 0000000..a2e14c6
--- /dev/null
+++ b/frontend/src/features/ai-analysis/lib/prone.ts
@@ -0,0 +1,25 @@
+import type { AnalysisFrame, Landmark } from '../types';
+
+export const PRONE_MS = 10_000; // 엎드림이 이 시간 이상 지속되면 수면
+const MIN_VISIBILITY = 0.5;
+const HEAD_DOWN = 0.15; // (어깨선 - 코) / 어깨 너비. 엎드리면 0 근처
+
+const seen = (p?: Landmark): p is Landmark =>
+  !!p && (p.visibility ?? 0) >= MIN_VISIBILITY;
+
+// 한 프레임에서 엎드린 상태인지
+export function isProne(frame: AnalysisFrame): boolean {
+  const lm = frame.pose?.landmarks;
+  if (!lm) return false;
+  const ls = lm[11];
+  const rs = lm[12];
+  if (!seen(ls) || !seen(rs)) return false;
+  const width = Math.hypot(ls.x - rs.x, ls.y - rs.y);
+  if (width < 0.05) return false;
+  const nose = lm[0];
+  if (seen(nose)) {
+    return ((ls.y + rs.y) / 2 - nose.y) / width < HEAD_DOWN;
+  }
+  // 얼굴이 통째로 안 보이면 얼굴을 묻은 것으로 본다
+  return !seen(lm[7]) && !seen(lm[8]);
+}
