{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "incremental": true,
    "outDir": "./dist"
  },
  "include": ["backend/src", "prisma/**/*.ts"],
  "exclude": ["node_modules", "dist", "frontend"]
}
