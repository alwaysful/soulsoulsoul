+.break-gauge {
+  position: relative;
+  width: min(414px, 100%);
+  height: 28px;
+  border-radius: 999px;
+  background: #1a1d26;
+  color: #fff;
+  font-size: 0.85rem;
+  font-weight: 600;
+  font-variant-numeric: tabular-nums;
+  overflow: hidden;
+}
+
+.break-gauge-fill {
+  position: absolute;
+  inset: 0 auto 0 0;
+  background: #2fb36d;
+  transition: width 0.5s linear;
+}
+
+.break-gauge span {
+  position: relative;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  height: 100%;
+}
+
+.analysis-right .break-gauge {
+  margin-bottom: 12px;
+}
+
+.break-buttons {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 8px;
+}
+
+.break-btn {
+  padding: 8px 16px;
+  border: 1px solid #2a2e3a;
+  border-radius: 999px;
+  background: #151821;
+  color: #e6e8ee;
+  font: inherit;
+  font-size: 0.9rem;
+  cursor: pointer;
+}
+
+.break-btn:hover {
+  border-color: #2fb36d;
+}
