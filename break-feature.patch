diff --git a/frontend/src/features/ai-analysis/hooks/useBreak.ts b/frontend/src/features/ai-analysis/hooks/useBreak.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/features/ai-analysis/hooks/useBreak.ts
@@ -0,0 +1,54 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { notifyDesktop } from '../lib/notify';
+
+export const BREAK_MINUTES = [3, 5, 10] as const;
+const BREAK_DONE = '휴식 끝. 다시 공부하세요.';
+
+export function useBreak() {
+  const [totalMs, setTotalMs] = useState(0);
+  const [remainingMs, setRemainingMs] = useState(0);
+  const [toast, setToast] = useState<string | null>(null);
+  const endAt = useRef(0);
+
+  const start = useCallback((minutes: number) => {
+    const ms = minutes * 60_000;
+    endAt.current = Date.now() + ms;
+    setToast(null);
+    setTotalMs(ms);
+    setRemainingMs(ms);
+  }, []);
+
+  // 즉시 종료 (알림 없음)
+  const end = useCallback(() => {
+    setTotalMs(0);
+    setRemainingMs(0);
+  }, []);
+
+  useEffect(() => {
+    if (totalMs === 0) return;
+    const id = setInterval(() => {
+      const left = endAt.current - Date.now();
+      if (left <= 0) {
+        setTotalMs(0);
+        setRemainingMs(0);
+        setToast(BREAK_DONE);
+        notifyDesktop('휴식 종료', BREAK_DONE);
+        return;
+      }
+      setRemainingMs(left);
+    }, 500);
+    return () => clearInterval(id);
+  }, [totalMs]);
+
+  const dismiss = useCallback(() => setToast(null), []);
+
+  return {
+    active: totalMs > 0,
+    totalMs,
+    remainingMs,
+    toast,
+    start,
+    end,
+    dismiss,
+  };
+}
diff --git a/frontend/src/features/ai-analysis/components/BreakGauge.tsx b/frontend/src/features/ai-analysis/components/BreakGauge.tsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/features/ai-analysis/components/BreakGauge.tsx
@@ -0,0 +1,48 @@
+import { BREAK_MINUTES } from '../hooks/useBreak';
+import '../break.css';
+
+function mmss(ms: number): string {
+  const s = Math.max(0, Math.ceil(ms / 1000));
+  return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
+}
+
+interface GaugeProps {
+  remainingMs: number;
+  totalMs: number;
+}
+
+// 남은 휴식 시간 게이지 (휴식 중일 때만 표시)
+export function BreakGauge({ remainingMs, totalMs }: GaugeProps) {
+  if (totalMs <= 0) return null;
+  const pct = Math.min(100, Math.max(0, (remainingMs / totalMs) * 100));
+  return (
+    <div
+      className="break-gauge"
+      role="progressbar"
+      aria-label="남은 휴식 시간"
+      aria-valuemin={0}
+      aria-valuemax={100}
+      aria-valuenow={Math.round(pct)}
+    >
+      <div className="break-gauge-fill" style={{ width: `${pct}%` }} />
+      <span>휴식 {mmss(remainingMs)}</span>
+    </div>
+  );
+}
+
+export function BreakButtons({ onStart }: { onStart: (minutes: number) => void }) {
+  return (
+    <div className="break-buttons">
+      {BREAK_MINUTES.map((m) => (
+        <button
+          key={m}
+          type="button"
+          className="break-btn"
+          onClick={() => onStart(m)}
+        >
+          {m}분 휴식
+        </button>
+      ))}
+    </div>
+  );
+}
