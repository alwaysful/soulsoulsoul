@@ -0,0 +1,26 @@
+import type { AnalysisService } from '../types';
+import { createObjectService } from './objectService';
+import { createPoseService } from './poseService';
+
+export async function createAnalysisService(): Promise<AnalysisService> {
+  const pose = await createPoseService();
+  let objects: Awaited<ReturnType<typeof createObjectService>>;
+  try {
+    objects = await createObjectService();
+  } catch (e) {
+    pose.close();
+    throw e;
+  }
+
+  return {
+    analyze: (video, timestamp) => ({
+      timestamp,
+      pose: pose.detect(video, timestamp),
+      objects: objects.detect(video, timestamp),
+    }),
+    close() {
+      pose.close();
+      objects.close();
+    },
+  };
+}
diff --git a/frontend/src/features/ai-analysis/services/objectService.ts b/frontend/src/features/ai-analysis/services/objectService.ts
new file mode 100644
index 0000000..3a9ed5a
--- /dev/null
+++ b/frontend/src/features/ai-analysis/services/objectService.ts
@@ -0,0 +1,38 @@
+import { ObjectDetector } from '@mediapipe/tasks-vision';
+import type { DetectedObject, VisionService } from '../types';
+import { getVision } from './visionRuntime';
+
+// COCO 라벨 모델: 스마트폰 클래스명은 'cell phone'
+export const OBJECT_MODEL_URL = '/models/efficientdet_lite0.tflite';
+const TARGET_LABELS = ['cell phone'];
+
+export async function createObjectService(): Promise<
+  VisionService<DetectedObject[]>
+> {
+  const vision = await getVision();
+  const detector = await ObjectDetector.createFromOptions(vision, {
+    baseOptions: { modelAssetPath: OBJECT_MODEL_URL, delegate: 'GPU' },
+    runningMode: 'VIDEO',
+    scoreThreshold: 0.4,
+    categoryAllowlist: TARGET_LABELS,
+  });
+
+  return {
+    detect(video, timestamp) {
+      const res = detector.detectForVideo(video, timestamp);
+      return res.detections.flatMap((d) => {
+        const c = d.categories[0];
+        const b = d.boundingBox;
+        if (!c || !b) return [];
+        return [
+          {
+            label: c.categoryName,
+            score: c.score,
+            box: { x: b.originX, y: b.originY, width: b.width, height: b.height },
+          },
+        ];
+      });
+    },
+    close: () => detector.close(),
+  };
+}
