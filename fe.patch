diff --git a/FE/src/pages/PostDetailPage.tsx b/FE/src/pages/PostDetailPage.tsx
new file mode 100644
index 0000000..8e5a8c1
--- /dev/null
+++ b/FE/src/pages/PostDetailPage.tsx
@@ -0,0 +1,101 @@
+import { useEffect, useState } from 'react';
+import { Link, useNavigate, useParams } from 'react-router-dom';
+import { ApiError } from '../api/client';
+import { postApi } from '../api/posts';
+import { useAuth } from '../auth/AuthContext';
+import { ErrorMessage } from '../components/ErrorMessage';
+import { errorText, formatDate } from '../components/format';
+import type { Post } from '../types';
+
+export function PostDetailPage() {
+  const { id } = useParams<{ id: string }>();
+  const { user } = useAuth();
+  const navigate = useNavigate();
+
+  const [post, setPost] = useState<Post | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    if (!id) return;
+    let cancelled = false;
+    setPost(null);
+    setError(null);
+    postApi
+      .get(id)
+      .then((p) => !cancelled && setPost(p))
+      .catch((e: unknown) => {
+        if (cancelled) return;
+        setError(
+          e instanceof ApiError && e.status === 404
+            ? '글을 찾을 수 없습니다.'
+            : errorText(e),
+        );
+      });
+    return () => {
+      cancelled = true;
+    };
+  }, [id]);
+
+  const authorId = post?.authorId ?? post?.author?.id;
+  // 작성자 정보가 없으면 로그인 사용자에게 버튼을 보이고, 권한은 서버가 검사한다
+  const canEdit = !!user && (!authorId || authorId === user.userId);
+
+  const handleDelete = async () => {
+    if (!id || !window.confirm('이 글을 삭제할까요?')) return;
+    setBusy(true);
+    setError(null);
+    try {
+      await postApi.remove(id);
+      navigate('/', { replace: true });
+    } catch (e) {
+      setError(errorText(e));
+      setBusy(false);
+    }
+  };
+
+  if (error && !post) {
+    return (
+      <section>
+        <ErrorMessage message={error} />
+        <Link to="/" className="btn">
+          목록으로
+        </Link>
+      </section>
+    );
+  }
+  if (!post) return <p className="muted">불러오는 중</p>;
+
+  return (
+    <article>
+      <p className="post-meta">
+        {post.category?.name && <span className="tag">{post.category.name}</span>}
+        {post.author && <span>{post.author.username ?? post.author.email}</span>}
+        <span>{formatDate(post.createdAt)}</span>
+      </p>
+      <h1>{post.title}</h1>
+      <div className="post-body">{post.content}</div>
+      <ErrorMessage message={error} />
+      <div className="row">
+        <Link to="/" className="btn btn-ghost">
+          목록으로
+        </Link>
+        {canEdit && (
+          <>
+            <Link to={`/posts/${post.id}/edit`} className="btn">
+              수정
+            </Link>
+            <button
+              type="button"
+              className="btn btn-danger"
+              disabled={busy}
+              onClick={handleDelete}
+            >
+              삭제
+            </button>
+          </>
+        )}
+      </div>
+    </article>
+  );
+}
diff --git a/FE/src/pages/PostFormPage.tsx b/FE/src/pages/PostFormPage.tsx
new file mode 100644
index 0000000..dce8183
--- /dev/null
+++ b/FE/src/pages/PostFormPage.tsx
@@ -0,0 +1,114 @@
+import { useEffect, useState, type FormEvent } from 'react';
+import { useNavigate, useParams } from 'react-router-dom';
+import { categoryApi } from '../api/categories';
+import { postApi } from '../api/posts';
+import { ErrorMessage } from '../components/ErrorMessage';
+import { errorText } from '../components/format';
+import type { Category } from '../types';
+
+export function PostFormPage() {
+  const { id } = useParams<{ id: string }>();
+  const isEdit = !!id;
+  const navigate = useNavigate();
+
+  const [categories, setCategories] = useState<Category[]>([]);
+  const [title, setTitle] = useState('');
+  const [content, setContent] = useState('');
+  const [categoryId, setCategoryId] = useState('');
+  const [error, setError] = useState<string | null>(null);
+  const [loading, setLoading] = useState(isEdit);
+  const [saving, setSaving] = useState(false);
+
+  useEffect(() => {
+    categoryApi
+      .list()
+      .then(setCategories)
+      .catch(() => setCategories([]));
+  }, []);
+
+  useEffect(() => {
+    if (!id) return;
+    let cancelled = false;
+    postApi
+      .get(id)
+      .then((p) => {
+        if (cancelled) return;
+        setTitle(p.title);
+        setContent(p.content);
+        setCategoryId(String(p.categoryId ?? p.category?.id ?? ''));
+      })
+      .catch((e: unknown) => !cancelled && setError(errorText(e)))
+      .finally(() => !cancelled && setLoading(false));
+    return () => {
+      cancelled = true;
+    };
+  }, [id]);
+
+  const handleSubmit = async (e: FormEvent) => {
+    e.preventDefault();
+    setError(null);
+    setSaving(true);
+    try {
+      const body = {
+        title: title.trim(),
+        content,
+        categoryId: categoryId ? Number(categoryId) : undefined,
+      };
+      const saved = id ? await postApi.update(id, body) : await postApi.create(body);
+      navigate(saved?.id ? `/posts/${saved.id}` : '/', { replace: true });
+    } catch (err) {
+      setError(errorText(err));
+      setSaving(false);
+    }
+  };
+
+  if (loading) return <p className="muted">불러오는 중</p>;
+
+  return (
+    <section>
+      <h1>{isEdit ? '글 수정' : '글쓰기'}</h1>
+      <form onSubmit={handleSubmit} className="form">
+        {categories.length > 0 && (
+          <label>
+            카테고리
+            <select value={categoryId} onChange={(e) => setCategoryId(e.target.value)}>
+              <option value="">선택 안 함</option>
+              {categories.map((c) => (
+                <option key={c.id} value={c.id}>
+                  {c.name}
+                </option>
+              ))}
+            </select>
+          </label>
+        )}
+        <label>
+          제목
+          <input
+            type="text"
+            value={title}
+            onChange={(e) => setTitle(e.target.value)}
+            required
+          />
+        </label>
+        <label>
+          내용
+          <textarea
+            value={content}
+            onChange={(e) => setContent(e.target.value)}
+            rows={12}
+            required
+          />
+        </label>
+        <ErrorMessage message={error} />
+        <div className="row">
+          <button type="submit" className="btn btn-primary" disabled={saving}>
+            {saving ? '저장 중' : isEdit ? '수정 저장' : '등록'}
+          </button>
+          <button type="button" className="btn btn-ghost" onClick={() => navigate(-1)}>
+            취소
+          </button>
+        </div>
+      </form>
+    </section>
+  );
+}
diff --git a/FE/src/pages/PostListPage.tsx b/FE/src/pages/PostListPage.tsx
