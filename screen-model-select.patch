diff --git a/frontend/src/features/ai-analysis/components/ModelSelect.tsx b/frontend/src/features/ai-analysis/components/ModelSelect.tsx
new file mode 100644
--- /dev/null
+++ b/frontend/src/features/ai-analysis/components/ModelSelect.tsx
@@ -0,0 +1,24 @@
+import { SCREEN_MODELS, type ScreenModel } from '../../../api/study';
+
+interface Props {
+  value: ScreenModel;
+  onChange: (model: ScreenModel) => void;
+}
+
+export function ModelSelect({ value, onChange }: Props) {
+  return (
+    <select
+      className="model-select"
+      aria-label="화면 분석 모델"
+      title="화면 분석 모델"
+      value={value}
+      onChange={(e) => onChange(e.target.value as ScreenModel)}
+    >
+      {SCREEN_MODELS.map((m) => (
+        <option key={m} value={m}>
+          {m}
+        </option>
+      ))}
+    </select>
+  );
+}
diff --git a/frontend/src/features/ai-analysis/hooks/useScreenModel.ts b/frontend/src/features/ai-analysis/hooks/useScreenModel.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/features/ai-analysis/hooks/useScreenModel.ts
@@ -0,0 +1,31 @@
+import { useCallback, useState } from 'react';
+import {
+  DEFAULT_SCREEN_MODEL,
+  SCREEN_MODELS,
+  type ScreenModel,
+} from '../../../api/study';
+
+const MODEL_KEY = 'screenModel';
+
+function load(): ScreenModel {
+  try {
+    const v = localStorage.getItem(MODEL_KEY);
+    return SCREEN_MODELS.find((m) => m === v) ?? DEFAULT_SCREEN_MODEL;
+  } catch {
+    return DEFAULT_SCREEN_MODEL;
+  }
+}
+
+// 선택한 화면 분석 모델 (localStorage 에 기억)
+export function useScreenModel() {
+  const [model, setModelState] = useState<ScreenModel>(load);
+  const setModel = useCallback((m: ScreenModel) => {
+    setModelState(m);
+    try {
+      localStorage.setItem(MODEL_KEY, m);
+    } catch {
+      /* 저장 실패는 무시 */
+    }
+  }, []);
+  return [model, setModel] as const;
+}
