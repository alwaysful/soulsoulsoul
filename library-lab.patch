+  place-items: center;
+  width: 160px;
+  height: 200px;
+  padding: 0;
+  overflow: hidden;
+  border: 2px dashed var(--line);
+  border-radius: var(--radius);
+  background: var(--bg);
+  color: var(--muted);
+  cursor: pointer;
+}
+
+.lab-drop:hover {
+  border-color: var(--accent);
+}
+
+.lab-drop img {
+  width: 100%;
+  height: 100%;
+  object-fit: cover;
+}
+
+.lab-col {
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: 8px;
+  min-width: 200px;
+}
+
+.lab-tower-wrap {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: flex-end;
+  gap: 20px;
+}
+
+.lab-tower-wrap .lab-result {
+  flex: 1;
+  min-width: 220px;
+}
+
+.lab-tower {
+  display: flex;
+  flex-direction: column-reverse;
+  align-items: center;
+  width: 160px;
+  padding-bottom: 4px;
+  border-bottom: 3px solid var(--muted);
+  transform-origin: bottom center;
+}
+
+.lab-tbook {
+  height: 12px;
+  margin-top: 1px;
+  border-radius: 2px;
+}
+
+.lab-tower.lv1 { animation: lab-wobble 3s ease-in-out infinite; }
+.lab-tower.lv2 { animation: lab-wobble 1.8s ease-in-out infinite; }
+.lab-tower.lv3 { animation: lab-wobble 0.9s ease-in-out infinite; }
+.lab-tower.lv4 { animation: lab-wobble 0.4s ease-in-out infinite; }
+
+@keyframes lab-wobble {
+  0%, 100% { transform: rotate(-1.5deg); }
+  50% { transform: rotate(1.5deg); }
+}
+
+@keyframes lab-pop {
+  from { opacity: 0; transform: translateY(4px); }
+  to { opacity: 1; transform: none; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .lab-tower,
+  .lab-result {
+    animation: none !important;
+  }
+}
