+.lib-results li {
+  display: flex;
+  flex-direction: column;
+  padding: 10px 0;
+  border-top: 1px solid var(--line);
+}
+
+.lib-results li span {
+  color: var(--muted);
+  font-size: 0.88rem;
+}
+
 .library-links {
   display: grid;
