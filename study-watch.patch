+import { FaceLandmarker } from '@mediapipe/tasks-vision';
+import type { FaceResult, VisionService } from '../types';
+import { getVision, withDelegateFallback } from './visionRuntime';
+
+export const FACE_MODEL_URL = '/models/face_landmarker.task';
+
+export async function createFaceService(): Promise<
+  VisionService<FaceResult | null>
+> {
+  const vision = await getVision();
+  const landmarker = await withDelegateFallback((delegate) =>
+    FaceLandmarker.createFromOptions(vision, {
+      baseOptions: { modelAssetPath: FACE_MODEL_URL, delegate },
+      runningMode: 'VIDEO',
+      numFaces: 1,
+      outputFaceBlendshapes: true,
+    }),
+  );
+
+  return {
+    detect(video, timestamp) {
+      const res = landmarker.detectForVideo(video, timestamp);
+      const cats = res.faceBlendshapes[0]?.categories;
+      if (!cats) return null;
+      const score = (name: string) =>
+        cats.find((c) => c.categoryName === name)?.score ?? 0;
+      return {
+        eyeBlink: (score('eyeBlinkLeft') + score('eyeBlinkRight')) / 2,
+      };
+    },
+    close: () => landmarker.close(),
+  };
+}
diff --git a/frontend/src/features/ai-analysis/services/screenCaptureService.ts b/frontend/src/features/ai-analysis/services/screenCaptureService.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/features/ai-analysis/services/screenCaptureService.ts
@@ -0,0 +1,48 @@
+const MAX_WIDTH = 1280;
+const QUALITY = 0.6;
+
+export interface ScreenSession {
+  // JPEG base64 (접두어 없음). 아직 프레임이 없으면 null
+  capture: () => string | null;
+  onEnded: (cb: () => void) => void;
+  close: () => void;
+}
+
+export async function openScreen(): Promise<ScreenSession> {
+  const stream = await navigator.mediaDevices.getDisplayMedia({
+    video: true,
+    audio: false,
+  });
+  const video = document.createElement('video');
+  video.muted = true;
+  video.srcObject = stream;
+  try {
+    await video.play();
+  } catch (e) {
+    stream.getTracks().forEach((t) => t.stop());
+    throw e;
+  }
+  const canvas = document.createElement('canvas');
+
+  return {
+    capture() {
+      const w = video.videoWidth;
+      const h = video.videoHeight;
+      if (!w || !h) return null;
+      const scale = Math.min(1, MAX_WIDTH / w);
+      canvas.width = Math.round(w * scale);
+      canvas.height = Math.round(h * scale);
+      const ctx = canvas.getContext('2d');
+      if (!ctx) return null;
+      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
+      return canvas.toDataURL('image/jpeg', QUALITY).split(',')[1] ?? null;
+    },
+    onEnded(cb) {
+      stream.getVideoTracks()[0]?.addEventListener('ended', cb);
+    },
+    close() {
+      stream.getTracks().forEach((t) => t.stop());
+      video.srcObject = null;
+    },
+  };
+}
diff --git a/frontend/src/features/ai-analysis/hooks/useScreenWatch.ts b/frontend/src/features/ai-analysis/hooks/useScreenWatch.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/features/ai-analysis/hooks/useScreenWatch.ts
@@ -0,0 +1,98 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { studyApi, type ScreenCheck } from '../../../api/study';
+import { errorText } from '../../../components/format';
+import { notifyDesktop } from '../lib/notify';
+import { openScreen, type ScreenSession } from '../services/screenCaptureService';
+
+const CAPTURE_MS = 30_000; // 캡처 간격
+const TOAST_COOLDOWN_MS = 60_000;
+const TOAST_MS = 8_000;
+
+export function useScreenWatch() {
+  const [active, setActive] = useState(false);
+  const [error, setError] = useState<string | null>(null);
+  const [toast, setToast] = useState<string | null>(null);
+  const [last, setLast] = useState<ScreenCheck | null>(null);
+  const stopRef = useRef<(() => void) | null>(null);
+  const aliveRef = useRef(true);
+
+  const stop = useCallback(() => {
+    stopRef.current?.();
+    stopRef.current = null;
+    setActive(false);
+    setLast(null);
+  }, []);
+
+  const start = useCallback(async () => {
+    if (stopRef.current) return;
+    setError(null);
+
+    let session: ScreenSession;
+    try {
+      session = await openScreen();
+    } catch (e) {
+      setError(errorText(e));
+      return;
+    }
+    if (!aliveRef.current) {
+      session.close();
+      return;
+    }
+
+    let busy = false;
+    let closed = false;
+    let lastToast = 0;
+
+    const tick = async () => {
+      if (busy || closed) return;
+      busy = true;
+      try {
+        const image = session.capture();
+        if (!image) return;
+        const res = await studyApi.screenCheck(image);
+        if (closed) return;
+        setLast(res);
+        const now = Date.now();
+        if (res.distracted && res.message && now - lastToast >= TOAST_COOLDOWN_MS) {
+          lastToast = now;
+          setToast(res.message);
+          notifyDesktop('딴짓 감지', res.message);
+        }
+      } catch (e) {
+        if (!closed) setError(errorText(e));
+      } finally {
+        busy = false;
+      }
+    };
+
+    const timer = setInterval(() => void tick(), CAPTURE_MS);
+    stopRef.current = () => {
+      closed = true;
+      clearInterval(timer);
+      session.close();
+    };
+    // 브라우저의 "공유 중지" 버튼
+    session.onEnded(stop);
+    setActive(true);
+    void tick();
+  }, [stop]);
+
+  useEffect(() => {
+    aliveRef.current = true;
+    return () => {
+      aliveRef.current = false;
+      stopRef.current?.();
+      stopRef.current = null;
+    };
+  }, []);
+
+  useEffect(() => {
+    if (!toast) return;
+    const id = setTimeout(() => setToast(null), TOAST_MS);
+    return () => clearTimeout(id);
+  }, [toast]);
+
+  const dismiss = useCallback(() => setToast(null), []);
+
+  return { active, error, toast, last, start, stop, dismiss };
+}
diff --git a/frontend/src/features/ai-analysis/hooks/useSleep.ts b/frontend/src/features/ai-analysis/hooks/useSleep.ts
new file mode 100644
--- /dev/null
+++ b/frontend/src/features/ai-analysis/hooks/useSleep.ts
@@ -0,0 +1,94 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+import { notificationApi } from '../../../api/notifications';
+import { sleepApi } from '../../../api/sleep';
+import { errorText } from '../../../components/format';
+import { notifyDesktop } from '../lib/notify';
+import { formatDuration, isSleepy } from '../lib/sleep';
+import type { AnalysisFrame } from '../types';
+
+const SLEEP_MS = 120_000; // 이 시간 이상 졸음 상태면 수면으로 판정
+const WAKE_GRACE_MS = 15_000; // 이 시간 이상 깨어 있으면 기상으로 판정 (눈 깜빡임 흡수)
+const TOAST_MS = 8_000;
+const START_MESSAGES = [
+  '잘 자요. 공부는 제가 대신 못 합니다.',
+  '도서관을 숙박시설로 이용해 주셔서 감사합니다.',
+  '오늘의 학습 성과: 렘수면 진입 성공.',
+];
+
+export function useSleep(frame: AnalysisFrame | null, deviceId: string) {
+  const [sleeping, setSleeping] = useState(false);
+  const [toast, setToast] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+
+  const since = useRef<number | null>(null); // 졸음 시작 추정 시각
+  const last = useRef(0); // 마지막으로 졸음이 관측된 시각
+  const active = useRef(false);
+  const device = useRef(deviceId);
+  device.current = deviceId;
+
+  const push = useCallback((kind: 'sleep-start' | 'sleep-end', sec?: number) => {
+    if (!device.current) return;
+    notificationApi
+      .phoneAlert(device.current, kind, sec)
+      .catch((e: unknown) => setError(errorText(e)));
+  }, []);
+
+  const finish = useCallback(
+    (startedAt: number, endedAt: number) => {
+      active.current = false;
+      setSleeping(false);
+      const sec = Math.max(1, Math.round((endedAt - startedAt) / 1000));
+      const msg = `좋은 꿈 꾸셨나요? 회원님이 공부 중 실종된 시간: ${formatDuration(sec)}`;
+      setToast(msg);
+      notifyDesktop('수면 종료', msg);
+      push('sleep-end', sec);
+      sleepApi
+        .create({
+          startedAt: new Date(startedAt).toISOString(),
+          endedAt: new Date(endedAt).toISOString(),
+        })
+        .catch((e: unknown) => setError(errorText(e)));
+    },
+    [push],
+  );
+
+  useEffect(() => {
+    // 분석 중지: 수면 중이었다면 마지막 관측 시각으로 종료 처리
+    if (!frame) {
+      if (active.current && since.current !== null) {
+        finish(since.current, last.current);
+      }
+      since.current = null;
+      active.current = false;
+      return;
+    }
+
+    const now = Date.now();
+    if (isSleepy(frame)) {
+      since.current ??= now;
+      last.current = now;
+      if (!active.current && now - since.current >= SLEEP_MS) {
+        active.current = true;
+        setSleeping(true);
+        const msg = START_MESSAGES[Math.floor(Math.random() * START_MESSAGES.length)];
+        setToast(msg);
+        notifyDesktop('수면 감지', msg);
+        push('sleep-start');
+      }
+    } else if (since.current !== null && now - last.current > WAKE_GRACE_MS) {
+      if (active.current) finish(since.current, last.current);
+      since.current = null;
+      active.current = false;
+    }
+  }, [frame, finish, push]);
+
+  useEffect(() => {
+    if (!toast) return;
+    const id = setTimeout(() => setToast(null), TOAST_MS);
+    return () => clearTimeout(id);
+  }, [toast]);
+
+  const dismiss = useCallback(() => setToast(null), []);
+
+  return { sleeping, toast, error, dismiss };
+}
