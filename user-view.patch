@@ -0,0 +1,100 @@
+.study {
+  --s-bg: #0f1115;
+  --s-line: #2a2e3a;
+  --s-mute: #8b90a0;
+  --s-hot: #ff5a36;
+  --s-red: #ff3b30;
+  display: flex;
+  flex-direction: column;
+  align-items: center;
+  justify-content: center;
+  gap: 20px;
+  min-height: 70vh;
+  padding: 40px 16px;
+  border-radius: 16px;
+  background: var(--s-bg);
+  color: #fff;
+  text-align: center;
+}
+
+.study h2 {
+  margin: 0;
+  font-size: 2.2rem;
+}
+
+.study-hidden {
+  position: fixed;
+  left: -9999px;
+  top: 0;
+  width: 640px;
+  pointer-events: none;
+}
+
+.study-pill {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 8px 18px;
+  border-radius: 999px;
+  background: #1a1d26;
+  color: var(--s-mute);
+  font-weight: 600;
+}
+
+.study-pill.on {
+  color: var(--s-hot);
+}
+
+.study-dot {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--s-mute);
+}
+
+.study-pill.on .study-dot {
+  background: var(--s-hot);
+}
+
+.study-time {
+  font-size: 4.5rem;
+  font-weight: 800;
+  line-height: 1;
+  font-variant-numeric: tabular-nums;
+}
+
+.study-sub {
+  margin: 0;
+  color: var(--s-mute);
+}
+
+.study-main {
+  width: min(414px, 100%);
+  padding: 20px;
+  border: 0;
+  border-radius: 14px;
+  background: var(--s-hot);
+  color: #fff;
+  font: inherit;
+  font-size: 1.1rem;
+  font-weight: 700;
+  cursor: pointer;
+}
+
+.study-main.stop {
+  background: #2b2f3a;
+}
+
+.study-main:disabled {
+  opacity: 0.5;
+  cursor: not-allowed;
+}
+
+.study-chips {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: center;
+  gap: 12px;
+}
+
+.study-chip {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  padding: 12px 20px;
+  border: 1px solid var(--s-line);
+  border-radius: 999px;
+  background: #151821;
+  color: #e6e8ee;
+}
+
+.study-chip i {
+  width: 8px;
+  height: 8px;
+  border-radius: 50%;
+  background: var(--s-mute);
+}
+
+.study-chip.hot {
+  border-color: var(--s-red);
+}
+
+.study-chip.hot i {
+  background: var(--s-red);
+}
+
+.study-link {
+  border: 0;
+  background: none;
+  color: var(--s-mute);
+  font: inherit;
+  text-decoration: underline;
+  cursor: pointer;
+}
